---
import '@fontsource/great-vibes/latin-400.css';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNav from '../components/site/PageNav.astro';
import Avatar from '../components/site/Avatar.astro';
import HomeSection from '../components/home/HomeSection.astro';
import ProjectRow from '../components/home/ProjectRow.astro';
import ExperienceRows from '../components/home/ExperienceRows.astro';
import InterestRow from '../components/home/InterestRow.astro';
import GameRows from '../components/home/GameRows.astro';
import Doodle from '../components/doodles/Doodle.astro';
import Icon from '../components/icons/Icon.astro';
import { homeProfile, homeSections, projects, experiences, interests, games } from '../data/home';
import { rssUrl, siteConfig } from '../config/site';
import { formatDate, isoDate, sortByDateDesc } from '../utils/blog';

const allPosts = sortByDateDesc(await getCollection('blog', ({ data }) => data.draft !== true));
const latestPosts = allPosts.slice(0, 3);
---

<BaseLayout>
  <div class="container home-top">
    <section class="hero" id="intro" aria-labelledby="hero-name">
      <div class="hero__main">
        <p class="hero__eyebrow doodle-hover">
          <Doodle
            variant="asterisk"
            width={12}
            height={12}
            class="doodle--accent doodle-wiggle"
            strokeWidth={1.6}
          />
          开发者 · 个人主页
        </p>

        <h1 class="hero__name" id="hero-name">
          <span class="hero__name-mark">
            {homeProfile.name}
            <span class="hero__circle" aria-hidden="true">
              <Doodle variant="circle" width="100%" height="100%" strokeWidth={1.5} />
            </span>
          </span>
        </h1>

        <p class="hero__lead">{homeProfile.intro[0]}</p>
        <p class="hero__detail">{homeProfile.intro[1]}</p>
        <p class="hero__role">
          <span class="hero__role-label">CURRENT STUDY</span>
          {homeProfile.role}
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="#projects">看项目</a>
          <a class="btn" href="/blog">读博客</a>
          <a class="text-link" href="/about">关于我</a>
        </div>

        <ul class="icon-row hero__social" aria-label="社交与订阅">
          {
            siteConfig.social.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  aria-label={link.label}
                  title={link.label}
                >
                  <Icon name={link.icon} size={18} />
                </a>
              </li>
            ))
          }
          <li>
            <a href={rssUrl} aria-label="RSS 订阅" title="RSS">
              <Icon name="rss" size={18} />
            </a>
          </li>
        </ul>
      </div>

      <div class="hero__side">
        <Doodle
          variant="arrow"
          width={54}
          height={34}
          strokeWidth={1.8}
          class="doodle--ink hero__arrow"
        />
        <div class="hero__portrait">
          <Doodle
            variant="ring"
            width={232}
            height={232}
            strokeWidth={1.15}
            class="doodle--accent hero__ring"
          />
          <Avatar size="100%" shape="square" />
        </div>
      </div>
    </section>

    <div class="home-foot">
      {
        latestPosts[0] && (
          <p class="home-latest">
            <span class="home-latest__label">最近更新</span>
            <a href={`/blog/${latestPosts[0].id}`}>{latestPosts[0].data.title}</a>
            <time datetime={isoDate(latestPosts[0].data.pubDate)}>
              {formatDate(latestPosts[0].data.pubDate)}
            </time>
          </p>
        )
      }
      <PageNav sections={homeSections} label="Home 区块导航" />
    </div>
  </div>

  <div class="container">
    <HomeSection id="writing" label="最近">
      {
        latestPosts.length > 0 ? (
          <>
            <ul class="rows home-writing">
              {latestPosts.map((post) => (
                <li class="row">
                  <div class="row__body">
                    <h3 class="row__title">
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h3>
                    <p class="row__desc">{post.data.summary}</p>
                  </div>
                  <div class="row__meta">
                    <time datetime={isoDate(post.data.pubDate)}>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>
                </li>
              ))}
            </ul>
            <p class="writing__more">
              <a class="text-link" href="/blog">
                全部文章
              </a>
            </p>
          </>
        ) : (
          <p class="row__note">还没有公开文章。</p>
        )
      }
    </HomeSection>

    <HomeSection id="projects" label="项目">
      {
        projects.length > 0 ? (
          <ul class="rows home-projects">
            {projects.map((project, index) => (
              <ProjectRow project={project} index={index} />
            ))}
          </ul>
        ) : (
          <p class="row__note">还没有公开的项目内容。</p>
        )
      }
    </HomeSection>

    <HomeSection id="experience" label="经历">
      {
        experiences.length > 0 ? (
          <ExperienceRows items={experiences} />
        ) : (
          <p class="row__note">暂无经历内容。</p>
        )
      }
    </HomeSection>

    <HomeSection id="interests" label="兴趣">
      {
        interests.length > 0 ? (
          <InterestRow items={interests} />
        ) : (
          <p class="row__note">暂无兴趣内容。</p>
        )
      }
    </HomeSection>

    <HomeSection id="games" label="游戏">
      {games.length > 0 ? <GameRows items={games} /> : <p class="row__note">暂无游戏内容。</p>}
    </HomeSection>
  </div>
</BaseLayout>

<style>
  /* 首屏：简介 + 最近更新 + 锚点栏，栏宽与 Header 一致 */
  .home-top {
    display: flex;
    flex-direction: column;
    min-height: calc(74svh - var(--header-height) - var(--space-4));
    padding-top: var(--space-5);
  }

  .hero {
    position: relative;
    isolation: isolate;
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    align-items: center;
    gap: var(--space-7);
    margin-block: var(--space-3) var(--space-5);
    padding: clamp(1.75rem, 4vw, 3rem) clamp(1.25rem, 3.5vw, 3rem);
    background: radial-gradient(ellipse at 84% 50%, var(--color-accent-veil), transparent 44%);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .hero__main,
  .hero__side {
    position: relative;
    z-index: 1;
  }

  .hero__main {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    min-width: 0;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__name {
    position: relative;
    font-family: 'Great Vibes', var(--font-serif);
    font-size: clamp(3rem, 2.5rem + 2.8vw, 4.2rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .hero__name-mark {
    position: relative;
    display: inline-block;
    padding-inline: 0.04em;
  }

  /* 唯一的手绘圈选：比文字略大一圈，轻微倾斜 */
  .hero__circle {
    position: absolute;
    inset: -0.36em -0.85em;
    color: var(--doodle-stroke-soft);
    opacity: 0.55;
    transform: rotate(-1.8deg);
    pointer-events: none;
  }

  .hero__lead {
    margin: var(--space-2) 0 0;
    max-width: 32rem;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.6;
  }

  .hero__detail {
    margin: var(--space-1) 0 0;
    max-width: 55ch;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .hero__role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid var(--doodle-accent);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .hero__role-label {
    color: var(--doodle-accent);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-1);
  }

  .hero__social {
    margin-top: var(--space-2);
  }

  .hero__social a:hover {
    border-color: var(--doodle-accent);
    background: var(--doodle-accent);
    color: var(--color-bg);
  }

  .hero__side {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-width: 0;
  }

  :global(.hero__ring) {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: min(17rem, 135%);
    max-width: none;
    height: auto;
    color: var(--doodle-accent);
    opacity: 0.3;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.hero__ring) {
      animation: hero-ring-float 8s ease-in-out infinite;
    }

    @keyframes hero-ring-float {
      0%,
      100% {
        transform: translate(-50%, -50%) rotate(-2deg);
      }
      50% {
        transform: translate(-50%, calc(-50% - 6px)) rotate(2deg);
      }
    }
  }

  :global(.hero__arrow) {
    position: absolute;
    top: 2%;
    left: -0.75rem;
    transform: rotate(14deg);
    opacity: 0.75;
    pointer-events: none;
  }

  /* 头像只保留轻描边与一点暖色投影，让手绘圈线有呼吸空间。 */
  .hero__portrait {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: 13rem;
    max-width: 100%;
    aspect-ratio: 1;
    transform: rotate(-1deg);
    transition: transform var(--motion-base) var(--ease-spring);
  }

  .hero__portrait:hover {
    transform: rotate(0.8deg) translateY(-3px);
  }

  .hero__portrait :global(.avatar) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    background: var(--color-bg-soft);
    box-shadow: 0 10px 24px -20px var(--color-text);
  }

  .home-foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4) var(--space-3);
    border-top: 1px dashed var(--color-border-strong);
  }

  .home-latest {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
    margin: 0;
    font-size: var(--text-sm);
  }

  .home-latest__label,
  .home-latest time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-faint);
  }

  .home-latest a {
    position: relative;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .home-latest a::after {
    content: '↗';
    margin-left: 0.35em;
    color: var(--doodle-accent);
    font-family: var(--font-mono);
    font-size: 0.8em;
    transition: transform var(--motion-fast) var(--ease-spring);
  }

  .home-latest a:hover::after {
    display: inline-block;
    transform: translate(2px, -2px);
  }

  .home-latest a:hover {
    border-bottom-color: var(--color-text);
  }

  .writing__more {
    margin: var(--space-3) 0 0;
  }

  .home-writing {
    gap: 0;
  }

  .home-writing > .row {
    padding: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    background: transparent;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  .home-writing > .row:hover {
    transform: none;
    border-left-color: transparent;
    background: var(--color-accent-veil);
  }

  .home-section .row:not(.project-row)::before {
    display: none;
  }

  .home-section .row:not(.project-row):hover {
    background: transparent;
  }

  #experience .row__meta {
    padding: 0;
    border: 0;
    color: var(--color-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__portrait,
    .home-writing > .row {
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
      padding: var(--space-5);
    }

    .hero__side {
      justify-self: center;
      width: auto;
      padding-top: var(--space-3);
    }

    .hero__portrait {
      width: 8.5rem;
    }

    :global(.hero__ring) {
      width: 11rem;
    }

    :global(.hero__arrow) {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .home-top {
      min-height: 0;
      padding-top: var(--space-4);
    }

    .hero {
      margin-top: var(--space-2);
    }

    .hero__circle {
      inset: -0.32em -0.3em;
    }

    .home-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
