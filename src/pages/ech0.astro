---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Ech0Feed from '../components/ech0/Ech0Feed.astro';
import { siteConfig } from '../config/site';

const { ech0 } = siteConfig;
---

<BaseLayout title="Ech0" description="只读查看 Ech0 上的最新公开动态。">
  <div class="container page ech0-page">
    <PageHeader
      eyebrow="Ech0"
      title="最新动态"
      lead="碎片记录：照片、日常和一些临时的想法。"
      decoration="circle"
      mark
    >
      <div class="ech0-header">
        <p class="ech0-header__text">这里只读同步公开动态，新内容会直接出现在页面里。</p>
        <p class="ech0-header__meta">
          <span data-ech0-count>最近 {ech0.maxItems} 条</span>
          <span aria-hidden="true">·</span>
          <a class="text-link" href={ech0.siteUrl} target="_blank" rel="noopener noreferrer">
            echo.ssean.cn ↗
          </a>
        </p>
      </div>
    </PageHeader>

    <Ech0Feed />
  </div>
</BaseLayout>

<style>
  .ech0-page {
    display: grid;
    padding-bottom: var(--space-8);
  }

  .ech0-header {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .ech0-header__text {
    margin: 0;
    max-width: 42rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .ech0-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-faint);
  }
</style>
