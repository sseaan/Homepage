---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Icon from '../components/icons/Icon.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="项目"
  description={`${projects.length} 个正在维护的项目：桌面客户端、自托管服务与 RSS 工具。`}
>
  <div class="container page projects-page">
    <PageHeader
      eyebrow="Projects"
      title="项目"
      lead="四个一直在维护的小东西：两个桌面客户端、一个自托管服务，和一个 RSS 工具。"
      accent="blue"
    />

    <ul class="project-grid" aria-label="项目列表">
      {
        projects.map((project, index) => (
          <li
            class="project-card"
            id={project.slug}
            style={`--project-accent: var(--accent-${project.accent})`}
          >
            <a
              class="project-card__media"
              href={project.primaryUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`打开 ${project.name}（${project.status}，在新标签页打开）`}
            >
              <span class="project-card__badge">{project.status}</span>
              <Image
                src={project.preview}
                alt={project.previewAlt}
                widths={[320, 480, 640]}
                sizes="(min-width: 52rem) 18rem, (min-width: 34rem) 50vw, 100vw"
                format="webp"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </a>
            <div class="project-card__body">
              <p class="project-card__meta">
                <span class="project-card__dot" aria-hidden="true" />
                {project.meta}
              </p>
              <h2 class="project-card__name">
                <a href={project.primaryUrl} target="_blank" rel="noopener noreferrer">
                  {project.name}
                </a>
              </h2>
              <p class="project-card__desc">{project.tagline}</p>
              <ul class="tag-list project-card__tech" aria-label={`${project.name} 技术栈`}>
                {project.tech.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
              <p class="project-card__links">
                {project.links.map((link) => (
                  <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </p>
            </div>
          </li>
        ))
      }

      <li class="project-card project-card--more">
        <a
          class="project-card__more"
          href="https://github.com/sseaan"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="project-card__more-icon">
            <Icon name="github" size={22} />
          </span>
          <span class="project-card__more-text">
            <span class="project-card__more-title">还有几个实验</span>
            <span class="project-card__more-note">
              Nexthrum、Voxi、powguard 之外的零碎项目都在 GitHub。
            </span>
          </span>
          <span class="project-card__more-link">GitHub ↗</span>
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .projects-page {
    display: grid;
    gap: var(--space-6);
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    transition:
      border-color var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--color-text);
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }

  /* ---------- 预览 ---------- */

  .project-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
  }

  .project-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .project-card:hover .project-card__media :global(img) {
    transform: scale(1.02);
  }

  .project-card__badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
    padding: 0.12em 0.45em;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.02em;
  }

  /* ---------- 文字 ---------- */

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem 0.9rem 1rem;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .project-card__dot {
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--project-accent);
  }

  .project-card__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .project-card__name a {
    text-decoration: none;
  }

  .project-card__name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .project-card__desc {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .project-card__tech {
    gap: 0.3rem;
    margin-top: 0.1rem;
  }

  .project-card__tech :global(.tag) {
    padding: 0.12em 0.45em;
    font-size: 10px;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin: auto 0 0;
    padding-top: 0.35rem;
  }

  .project-card__links :global(.text-link) {
    font-size: var(--text-xs);
  }

  .project-card__links :global(.text-link:hover) {
    color: var(--project-accent);
    border-color: var(--project-accent);
  }

  /* ---------- 更多实验 ---------- */

  .project-card--more {
    border-style: dashed;
    background: var(--color-bg-soft);
  }

  .project-card__more {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.25rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .project-card__more-icon {
    display: grid;
    color: var(--color-faint);
    place-items: center;
  }

  .project-card__more-text {
    display: grid;
    gap: 0.2rem;
  }

  .project-card__more-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .project-card__more-note {
    font-size: var(--text-xs);
    color: var(--color-faint);
  }

  .project-card__more-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-faint);
  }

  .project-card--more:hover .project-card__more-link {
    color: var(--doodle-accent);
  }

  @media (min-width: 34rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* 平板 2 列时「更多」占满一行；桌面 3 列时正好补齐第二行 */
    .project-card--more {
      grid-column: span 2;
    }

    .project-card__more {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding-inline: 1.5rem;
    }

    .project-card__more-text {
      gap: 0.25rem;
    }

    .project-card__more-link {
      margin-left: auto;
    }
  }

  @media (min-width: 52rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }
  }
</style>
