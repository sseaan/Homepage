---
/**
 * 文章目录：把 h2/h3/h4 渲染成树状列表（嵌套层级用竖线连接）。
 * 组件通过 Astro.self 递归渲染子层级。
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface TreeNode extends Heading {
  children: TreeNode[];
}

interface Props {
  headings?: Heading[];
  nodes?: TreeNode[];
  /** 递归层级；0 为顶层，只有顶层显示序号 */
  level?: number;
}

const buildTree = (headings: Heading[]): TreeNode[] => {
  const roots: TreeNode[] = [];
  const stack: TreeNode[] = [];

  for (const heading of headings) {
    if (heading.depth < 2 || heading.depth > 4) continue;
    const node: TreeNode = { ...heading, children: [] };

    while (stack.length > 0 && stack[stack.length - 1].depth >= node.depth) stack.pop();

    const parent = stack[stack.length - 1];
    if (parent) parent.children.push(node);
    else roots.push(node);

    stack.push(node);
  }

  return roots;
};

const nodes = Astro.props.nodes ?? buildTree(Astro.props.headings ?? []);
const level = Astro.props.level ?? 0;
---

<ol class="toc__list">
  {
    nodes.map((node, index) => (
      <li class="toc__item">
        <a href={`#${node.slug}`} data-toc-link>
          <span class="toc__text">{node.text}</span>
          {level === 0 && (
            <span class="toc__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          )}
        </a>
        {node.children.length > 0 && <Astro.self nodes={node.children} level={level + 1} />}
      </li>
    ))
  }
</ol>

<style>
  .toc__list {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  .toc__item {
    position: relative;
  }

  .toc__item > a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.3rem 0.1rem 0.3rem 0.8rem;
    color: var(--color-muted);
    font-size: var(--text-2xs);
    line-height: 1.55;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .toc__list > .toc__item + .toc__item {
    margin-top: 0.4rem;
  }

  /* 当前节所在的顶层分组一起加深，方便定位 */
  .toc__item:has(a.is-active) > a {
    color: var(--color-text);
  }

  /* 左边缘的强调条：hover 半截、当前节满格 */
  .toc__item > a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.3em;
    bottom: 0.3em;
    width: 2px;
    background: var(--doodle-accent);
    transform: scaleY(0);
    transition: transform var(--motion-base) var(--ease-out);
  }

  .toc__item > a:hover {
    color: var(--color-text);
  }

  .toc__item > a:hover::before {
    transform: scaleY(0.45);
  }

  .toc__item > a.is-active {
    color: var(--color-text);
    font-weight: 600;
  }

  .toc__item > a.is-active::before {
    transform: scaleY(1);
  }

  .toc__text {
    min-width: 0;
  }

  .toc__index {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .toc__item > a.is-active .toc__index {
    color: var(--doodle-accent);
  }

  /* 子层级：虚线主干 + 短横分支 */
  .toc__list .toc__list {
    margin: 0.05rem 0 0.3rem 0.55rem;
    padding-left: 0.6rem;
    border-left-style: dashed;
  }

  .toc__list .toc__list .toc__item > a {
    padding-left: 0.55rem;
    color: var(--color-faint);
    font-size: var(--text-xs);
  }

  /* 子层的强调条压在虚线主干上 */
  .toc__list .toc__list .toc__item > a::before {
    left: calc(-0.6rem - 1px);
  }

  .toc__list .toc__list .toc__item::before {
    content: '';
    position: absolute;
    left: calc(-0.6rem - 1px);
    top: 0.85em;
    width: 5px;
    height: 1px;
    background: var(--color-border-strong);
  }
</style>
