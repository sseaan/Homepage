---
import Icon from '../icons/Icon.astro';

interface Props {
  /** 网易云歌曲链接或纯数字 ID；留空则不渲染 */
  music?: string;
  title: string;
}

const { music, title } = Astro.props;
const apiBase = (import.meta.env.PUBLIC_NETEASE_API_BASE ?? '').replace(/\/+$/, '');
const enabled = Boolean(music && apiBase);
---

{
  enabled && (
    <div
      class="article-music"
      data-music-player
      data-api-base={apiBase}
      data-song={music}
      data-article-title={title}
      data-state="loading"
    >
      <button
        class="article-music__cover"
        type="button"
        data-music-toggle
        aria-label="播放文章音乐"
        aria-pressed="false"
      >
        <span class="article-music__placeholder" data-music-placeholder>
          <Icon name="music" size={24} />
        </span>
        <img
          data-music-cover
          alt=""
          width="160"
          height="160"
          loading="lazy"
          decoding="async"
          hidden
        />
        <span class="article-music__icon" data-music-icon aria-hidden="true">
          ▶
        </span>
        <span class="article-music__spinner" data-music-spinner aria-hidden="true" />
      </button>
      <button
        class="article-music__close"
        type="button"
        data-music-close
        aria-label="关闭音乐播放器"
        title="关闭"
      >
        ×
      </button>
      <audio data-music-audio preload="none" />
      <p class="article-music__error" data-music-error role="status" hidden />
    </div>
  )
}

<style>
  .article-music {
    position: fixed;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: 40;
  }

  .article-music__cover {
    position: relative;
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    padding: 0;
    overflow: hidden;
    border: 1.5px solid var(--color-text);
    border-radius: var(--radius-card);
    background: var(--color-surface-soft);
    color: var(--color-text);
    box-shadow: var(--shadow-hard-ink);
    cursor: pointer;
    place-items: center;
  }

  .article-music__cover:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-text);
  }

  .article-music__cover:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .article-music__placeholder {
    display: grid;
    color: var(--color-muted);
    place-items: center;
  }

  .article-music [hidden] {
    display: none !important;
  }

  .article-music__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-music__icon {
    position: absolute;
    right: 0.25rem;
    bottom: 0.25rem;
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.55rem;
    line-height: 1;
    place-items: center;
  }

  .article-music__spinner {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-text);
    border-radius: 50%;
    animation: article-music-spin 700ms linear infinite;
  }

  .article-music[data-state='loading'] .article-music__spinner {
    display: block;
  }

  .article-music:not([data-state='loading']) .article-music__spinner {
    display: none;
  }

  .article-music[data-state='loading'] .article-music__icon {
    visibility: hidden;
  }

  .article-music__close {
    position: absolute;
    top: -0.45rem;
    right: -0.45rem;
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    place-items: center;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .article-music:hover .article-music__close,
  .article-music:focus-within .article-music__close,
  .article-music[data-state='error'] .article-music__close {
    opacity: 1;
  }

  .article-music__error {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    width: max-content;
    max-width: 15rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-sm);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
  }

  .article-music__error[hidden] {
    display: none;
  }

  .article-music audio {
    display: none;
  }

  @keyframes article-music-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 40rem) {
    .article-music__cover {
      width: 3.75rem;
      height: 3.75rem;
    }

    .article-music__close {
      opacity: 1;
    }
  }
</style>

<script>
  import { parseNeteaseSongId } from '../../lib/netease';

  const joinUrl = (base: string, path: string) => `${base.replace(/\/+$/, '')}${path}`;

  // HTTPS 站点上把 http 资源升级，本地 http 预览则保持原协议
  const secureUrl = (value: string) =>
    window.location.protocol === 'https:' ? value.replace(/^http:/, 'https:') : value;

  document.querySelectorAll<HTMLElement>('[data-music-player]').forEach((root) => {
    const apiBase = root.dataset.apiBase ?? '';
    const source = root.dataset.song ?? '';
    const songId = parseNeteaseSongId(source);
    const coverButton = root.querySelector<HTMLButtonElement>('[data-music-toggle]');
    const coverImage = root.querySelector<HTMLImageElement>('[data-music-cover]');
    const placeholder = root.querySelector<HTMLElement>('[data-music-placeholder]');
    const icon = root.querySelector<HTMLElement>('[data-music-icon]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-music-close]');
    const audio = root.querySelector<HTMLAudioElement>('[data-music-audio]');
    const error = root.querySelector<HTMLElement>('[data-music-error]');

    if (!apiBase || !songId || !coverButton || !audio || !coverImage) {
      root.remove();
      return;
    }

    let audioUrl: Promise<string | null> | null = null;
    let songLabel = '文章音乐';

    const showError = (message: string) => {
      root.dataset.state = 'error';
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
      if (icon) icon.textContent = '▶';
      coverButton.setAttribute('aria-pressed', 'false');
    };

    const setPlaying = (playing: boolean) => {
      root.dataset.state = playing ? 'playing' : 'ready';
      if (icon) icon.textContent = playing ? '❚❚' : '▶';
      coverButton.setAttribute('aria-pressed', String(playing));
      coverButton.setAttribute('aria-label', `${playing ? '暂停' : '播放'}音乐：${songLabel}`);
      if (playing && error) {
        error.hidden = true;
      }
    };

    const getAudioUrl = async (): Promise<string | null> => {
      if (!audioUrl) {
        audioUrl = (async () => {
          for (const level of ['exhigh', 'standard']) {
            const response = await fetch(
              joinUrl(apiBase, `/song/url/v1?id=${songId}&level=${level}`),
            );
            if (!response.ok) continue;
            const payload = await response.json();
            const url = payload?.data?.[0]?.url;
            if (typeof url === 'string' && url.length > 0) {
              return secureUrl(url);
            }
          }

          const legacy = await fetch(joinUrl(apiBase, `/song/url?id=${songId}`));
          if (!legacy.ok) return null;
          const payload = await legacy.json();
          const url = payload?.data?.[0]?.url;
          return typeof url === 'string' && url.length > 0 ? secureUrl(url) : null;
        })().catch(() => null);
      }

      return audioUrl;
    };

    const init = async () => {
      try {
        const response = await fetch(joinUrl(apiBase, `/song/detail?ids=${songId}`));
        if (!response.ok) throw new Error('detail');
        const payload = await response.json();
        const song = payload?.songs?.[0];

        if (!song) throw new Error('empty');

        songLabel = [song.name, song.ar?.map((artist: { name: string }) => artist.name).join(' / ')]
          .filter(Boolean)
          .join(' · ');

        const coverUrl = song.al?.picUrl;
        if (typeof coverUrl === 'string' && coverUrl.length > 0) {
          const secureCover = secureUrl(coverUrl);
          coverImage.src = `${secureCover}${secureCover.includes('?') ? '&' : '?'}param=320y320`;
          coverImage.alt = songLabel;
          coverImage.hidden = false;
          if (placeholder) placeholder.hidden = true;
        }

        coverButton.setAttribute('aria-label', `播放音乐：${songLabel}`);
        coverButton.title = songLabel;
        root.dataset.state = 'ready';
      } catch {
        showError('音乐信息加载失败');
        coverButton.disabled = true;
      }
    };

    coverButton.addEventListener('click', async () => {
      if (audio.paused) {
        try {
          const url = await getAudioUrl();
          if (!url) {
            showError('该歌曲暂不可播放');
            return;
          }

          if (!audio.src) audio.src = url;
          await audio.play();
        } catch {
          showError('播放失败，请稍后重试');
        }
      } else {
        audio.pause();
      }
    });

    coverImage.addEventListener('error', () => {
      coverImage.hidden = true;
      if (placeholder) placeholder.hidden = false;
    });

    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('ended', () => setPlaying(false));
    audio.addEventListener('error', () => showError('音频加载失败'));

    closeButton?.addEventListener('click', () => {
      audio.pause();
      root.remove();
    });

    init();
  });
</script>
