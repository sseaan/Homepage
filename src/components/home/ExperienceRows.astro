---
import type { ExperienceItem } from '../../data/home';

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<ul class="rows">
  {
    items.map((item) => (
      <li class="row">
        <div class="row__body">
          <h3 class="row__title">
            <span>{item.role}</span>
            <span class="row__tilde">~</span>
            <span class="row__org">{item.org}</span>
            {item.pending && <span class="pending">待补充</span>}
          </h3>
          <p class="row__desc">{item.summary}</p>
          {item.tags && item.tags.length > 0 && <p class="row__note">{item.tags.join(' · ')}</p>}
        </div>
        <div class="row__meta">
          <span>{item.period}</span>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .row__org {
    font-weight: 400;
    color: var(--color-muted);
  }
</style>
