---
import Icon from '../icons/Icon.astro';
import type { Game } from '../../data/home';

interface Props {
  items: Game[];
}

const { items } = Astro.props;
---

<ul class="rows">
  {
    items.map((item) => (
      <li class="row">
        <div class="row__body">
          <h3
            class="row__title"
            style={item.accent ? `color: var(--accent-${item.accent})` : undefined}
          >
            <Icon name={item.icon} size={15} />
            <span>{item.name}</span>
            {item.pending && <span class="pending">待补充</span>}
          </h3>
          <p class="row__desc">{item.note}</p>
        </div>
        <div class="row__meta">
          <span>{item.platform}</span>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .row__title :global(.icon) {
    color: var(--color-faint);
    align-self: center;
  }
</style>
