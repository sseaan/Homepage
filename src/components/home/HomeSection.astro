---
/** Home 区块标题与稳定锚点。 */
interface Props {
  id: string;
  label: string;
  /** 区块顶部刻线配色，对应 themes.css 的 --accent-* */
  accent?: 'warm' | 'blue' | 'green' | 'violet' | 'red';
}

const { id, label, accent = 'warm' } = Astro.props;
---

<section
  class="section home-section"
  id={id}
  aria-labelledby={`${id}-title`}
  style={`--section-accent: var(--accent-${accent})`}
>
  <div class="section-head">
    <h2 class="section-title" id={`${id}-title`}>{label}</h2>
  </div>
  <slot />
</section>

<style>
  .home-section {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .home-section :global(.section-title) {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-transform: none;
  }
</style>
