---
import Icon from '../icons/Icon.astro';
import type { Project } from '../../data/home';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<li class="row project-row">
  <span class="project-row__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div class="row__body project-row__body">
    <div class="project-row__eyebrow">
      {project.status && <span class="row__status">{project.status}</span>}
      {project.pending && <span class="pending">待补充</span>}
    </div>
    <h3 class="row__title project-row__title">{project.name}</h3>
    <p class="row__desc">{project.summary}</p>
    {
      project.tech.length > 0 && (
        <ul class="project-row__tech" aria-label={`${project.name} 技术栈`}>
          {project.tech.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="row__meta project-row__meta">
    {
      project.sourceUrl && (
        <a href={project.sourceUrl} rel="noopener noreferrer" target="_blank">
          <Icon name="github" size={14} />
          源码
          <span class="visually-hidden">（在新标签页打开）</span>
        </a>
      )
    }
    {
      project.demoUrl && (
        <a href={project.demoUrl} rel="noopener noreferrer" target="_blank">
          <Icon name="arrow-up-right" size={14} />
          演示
          <span class="visually-hidden">（在新标签页打开）</span>
        </a>
      )
    }
  </div>
</li>

<style>
  .row__status {
    color: var(--color-muted);
    font-weight: 500;
  }
</style>
