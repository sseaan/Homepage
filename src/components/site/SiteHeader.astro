---
import { siteConfig } from '../../config/site';
import ThemeControl from '../theme/ThemeControl.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
      {siteConfig.name}
      <span class="brand__dot" aria-hidden="true">.</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <ul>
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeControl />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--header-bg) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--doodle-accent) 28%, transparent);
  }

  .site-header::after {
    content: '';
    position: absolute;
    right: max(var(--gutter), calc((100vw - var(--content-width)) / 2 + var(--gutter)));
    bottom: -1px;
    width: 3.5rem;
    height: 2px;
    background: var(--doodle-accent);
    transform: rotate(-2deg);
    transform-origin: right center;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    min-height: 32px;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 650;
    letter-spacing: -0.035em;
    text-decoration: none;
    flex: none;
    transition: transform var(--motion-fast) var(--ease-spring);
  }

  .brand:hover {
    transform: translateY(-1px) rotate(-1deg);
  }

  .brand__dot {
    color: var(--doodle-accent);
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      color var(--motion-fast) var(--ease-out),
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-spring);
  }

  .site-nav__link:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: var(--color-accent-veil);
    transform: translateY(-1px) rotate(-1deg);
  }

  /* 当前页：反转成一枚小标签，避免只依赖颜色 */
  .site-nav__link.is-active {
    color: var(--color-bg);
    border-color: var(--color-text);
    background: var(--color-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 36rem) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2);
      gap: 0 var(--space-3);
    }

    .brand {
      flex: 1 1 auto;
    }

    .site-nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    .site-nav ul {
      justify-content: space-between;
      gap: 0;
    }

    .site-nav__link {
      padding: 0 var(--space-1);
    }
  }
</style>
