---
/**
 * 页内锚点导航：用于 Home 的五个区块。
 * 极简样式：一行小字链接，不抢标题层级。
 */
interface Props {
  /** accent 取自 themes.css 的 --accent-*，用于 hover 时的点缀色 */
  sections: readonly { id: string; label: string; accent?: string }[];
  label?: string;
}

const { sections, label = '页内导航' } = Astro.props;
---

<nav class="page-nav" aria-label={label}>
  <ul>
    {
      sections.map((section) => (
        <li>
          <a
            href={`#${section.id}`}
            style={section.accent ? `--section-accent: var(--accent-${section.accent})` : undefined}
          >
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .page-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .page-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 0.5rem;
    border: 1px solid transparent;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      background-color var(--motion-fast) var(--ease-out);
  }

  .page-nav a:hover,
  .page-nav a:focus-visible {
    color: var(--section-accent, var(--color-text));
    border-color: var(--color-border-strong);
    background: var(--color-veil);
  }
</style>
