---
/**
 * 各页面统一的页头：相同的上边距、标题字号、左侧对齐位置。
 * 可选的手绘装饰（下划线 / 圈选）和小星号只做视觉点缀。
 */
import Doodle from '../doodles/Doodle.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** 标题手绘装饰 */
  decoration?: 'underline' | 'squiggle' | 'circle';
  /** 标题旁的小星号 */
  mark?: boolean;
  /** 用于文章列表等简洁页头 */
  compact?: boolean;
  /** 页面点缀色，对应 themes.css 的 --accent-* */
  accent?: 'warm' | 'blue' | 'green' | 'violet' | 'red';
}

const { eyebrow, title, lead, decoration, mark = false, compact = false, accent } = Astro.props;
---

<header
  class:list={['page-head', compact && 'page-head--compact']}
  style={accent ? `--section-accent: var(--accent-${accent})` : undefined}
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-head__title">
    {
      decoration === 'circle' ? (
        <span class="page-head__circle-wrap">
          {title}
          <span class="page-head__circle" aria-hidden="true">
            <Doodle
              variant="circle"
              width="100%"
              height="100%"
              strokeWidth={1.3}
              class="doodle--draw"
            />
          </span>
        </span>
      ) : decoration ? (
        <span class="doodle-underline">
          {title}
          <Doodle variant={decoration} class="doodle-underline__svg" strokeWidth={2.6} />
        </span>
      ) : (
        title
      )
    }
    {
      mark && (
        <span class="page-head__mark" aria-hidden="true">
          <Doodle
            variant="asterisk"
            width={16}
            height={16}
            strokeWidth={1.4}
            class="doodle--draw"
          />
        </span>
      )
    }
  </h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-head {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .page-head :global(.eyebrow)::before {
    color: var(--section-accent, var(--color-faint));
  }

  .page-head :global(.eyebrow) {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    padding: 0.15em 0.55em;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-soft);
  }

  .page-head__title {
    position: relative;
    isolation: isolate;
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .page-head--compact {
    padding: var(--space-2) 0 var(--space-4);
    background: none;
  }

  .page-head--compact::before {
    display: none;
  }

  .page-head--compact :global(.eyebrow) {
    padding: 0;
    border: 0;
    background: transparent;
    transform: none;
  }

  .page-head--compact .page-head__title {
    font-size: clamp(2.1rem, 1.8rem + 1.1vw, 2.65rem);
  }

  .page-head--compact .page-head__mark {
    display: none;
  }

  .page-head__circle-wrap {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .page-head__circle {
    position: absolute;
    inset: -0.3em -0.52em;
    color: var(--doodle-stroke-soft);
    opacity: 0.5;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .page-head__mark {
    display: inline-block;
    margin-left: 0.3em;
    color: var(--section-accent, var(--doodle-accent));
    opacity: 0.8;
    vertical-align: super;
    transform: rotate(10deg);
  }
</style>
