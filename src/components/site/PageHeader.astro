---
/**
 * 各页面统一的页头：相同的上边距、标题字号、左侧对齐位置。
 * 可选的手绘装饰（下划线 / 圈选）和小星号只做视觉点缀。
 */
import Doodle from '../doodles/Doodle.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** 标题手绘装饰 */
  decoration?: 'underline' | 'squiggle' | 'circle';
  /** 标题旁的小星号 */
  mark?: boolean;
}

const { eyebrow, title, lead, decoration, mark = false } = Astro.props;
---

<header class="page-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-head__title">
    {
      decoration === 'circle' ? (
        <span class="page-head__circle-wrap">
          {title}
          <span class="page-head__circle" aria-hidden="true">
            <Doodle variant="circle" width="100%" height="100%" strokeWidth={1.3} />
          </span>
        </span>
      ) : decoration ? (
        <span class="doodle-underline">
          {title}
          <Doodle variant={decoration} class="doodle-underline__svg" strokeWidth={2.6} />
        </span>
      ) : (
        title
      )
    }
    {
      mark && (
        <span class="page-head__mark" aria-hidden="true">
          <Doodle variant="asterisk" width={16} height={16} strokeWidth={1.4} />
        </span>
      )
    }
  </h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-head {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .page-head__title {
    position: relative;
    isolation: isolate;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .page-head__circle-wrap {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .page-head__circle {
    position: absolute;
    inset: -0.3em -0.52em;
    color: var(--doodle-stroke-soft);
    opacity: 0.5;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .page-head__mark {
    display: inline-block;
    margin-left: 0.3em;
    color: var(--doodle-accent);
    opacity: 0.8;
    vertical-align: super;
    transform: rotate(10deg);
  }
</style>
