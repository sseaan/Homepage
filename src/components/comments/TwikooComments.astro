---
/**
 * Twikoo 评论区。
 *
 * - 脚本只在文章详情页渲染本组件时加载，且接近视口才开始拉取；
 * - 固定客户端版本与 CDN，不引用 latest；
 * - path 由构建时生成并归一化（去掉尾斜杠），保证同一篇文章只有一个评论线程；
 * - 脚本加载失败 / 初始化超时 / 后端未配置都有独立状态，文章正文不受影响；
 * - 视觉完全由 `comments.css` 重绘，依赖固定的 Twikoo 2.0.17 DOM 类名。
 */
import Icon from '../icons/Icon.astro';
import { siteConfig } from '../../config/site';
import '../../styles/comments.css';

interface Props {
  /** 稳定评论路径，例如 /blog/markdown-guide */
  path: string;
  /** 文章标题，传给 Twikoo 用于通知 */
  title?: string;
}

const { path: commentPath, title } = Astro.props;
const config = siteConfig.comments;
const envId = (import.meta.env.PUBLIC_TWIKOO_ENV_ID || config.envId || '').trim();
const scriptUrl = config.scriptUrl;
const normalizedPath = commentPath.replace(/\/+$/, '') || '/';
---

<section
  class="comments-shell"
  id="comments"
  data-comments
  data-env-id={envId}
  data-path={normalizedPath}
  data-title={title ?? siteConfig.name}
  data-script={scriptUrl}
  data-preload-margin={config.preloadMargin}
  data-timeout={String(config.timeoutMs)}
  aria-labelledby="comments-title"
>
  <header class="comments-head">
    <h2 class="section-title" id="comments-title">评论</h2>
    <span class="comments-count" data-comments-count hidden></span>
  </header>

  <p class="comments-intro">
    保持友善，尽量只讨论内容本身。邮箱仅用于头像与回复通知，不会公开显示。
  </p>

  {
    envId ? (
      <div class="comments-body">
        <div class="comments-status comments-status--loading" data-comments-loading role="status">
          <span class="comments-spinner" aria-hidden="true" />
          <span>正在加载评论…</span>
        </div>

        <div class="comments-status comments-status--error" data-comments-error role="alert" hidden>
          <Icon name="alert" size={16} />
          <div class="comments-error__body">
            <p class="comments-error__title">评论加载失败</p>
            <p class="comments-error__detail" data-comments-error-detail>
              请检查网络后重试。
            </p>
            <div class="comments-error__actions">
              <button class="btn" type="button" data-comments-retry>
                重试
              </button>
            </div>
          </div>
        </div>

        <div id="twikoo-comments" class="comments-mount" data-comments-mount hidden />

        <noscript>
          <p class="comments-status">评论需要启用 JavaScript 才能加载。</p>
        </noscript>
      </div>
    ) : (
      <div class="comments-status comments-status--setup">
        <Icon name="notebook" size={16} />
        <div>
          <p class="comments-error__title">评论暂未开放</p>
          <p class="comments-error__detail">站长还没有接入评论服务，稍后再来看看。</p>
        </div>
      </div>
    )
  }

  <p class="comments-foot">
    评论由
    <a href="https://twikoo.js.org" target="_blank" rel="noopener noreferrer">Twikoo</a>
    提供
  </p>
</section>

<script>
  type TwikooWindow = Window & {
    twikoo?: {
      init: (options: Record<string, unknown>) => Promise<void>;
    };
  };

  const initComments = () => {
    const shell = document.querySelector<HTMLElement>('[data-comments]:not([data-comments-ready])');
    if (!shell) return;
    shell.dataset.commentsReady = 'true';

    {
      const envId = shell.dataset.envId?.trim() ?? '';
      const scriptUrl = shell.dataset.script ?? '';
      const preloadMargin = shell.dataset.preloadMargin ?? '400px';
      const timeoutMs = Number(shell.dataset.timeout ?? '20000') || 20_000;

      const mount = shell.querySelector<HTMLElement>('[data-comments-mount]');
      const loading = shell.querySelector<HTMLElement>('[data-comments-loading]');
      const errorBox = shell.querySelector<HTMLElement>('[data-comments-error]');
      const errorDetail = shell.querySelector<HTMLElement>('[data-comments-error-detail]');
      const countEl = shell.querySelector<HTMLElement>('[data-comments-count]');
      const retryButton = shell.querySelector<HTMLButtonElement>('[data-comments-retry]');

      if (envId && mount && loading && errorBox) {
        let phase: 'idle' | 'loading' | 'ready' | 'error' = 'idle';
        let started = false;
        let watchdog = 0;
        let revealTimer = 0;
        let scriptPromise: Promise<void> | null = null;
        let countObserver: MutationObserver | null = null;

        /** 去掉尾斜杠、index.html，保证同一篇文章的评论路径稳定 */
        const normalizePath = (value: string): string => {
          let pathname = value;
          try {
            pathname = new URL(value, window.location.origin).pathname;
            pathname = decodeURI(pathname);
          } catch {
            // 不是合法 URL 时按原字符串处理
          }
          pathname = pathname.replace(/\/index\.html$/, '/').replace(/\/+$/, '');
          return pathname || '/';
        };

        const showLoading = () => {
          phase = 'loading';
          shell.dataset.state = 'loading';
          shell.setAttribute('aria-busy', 'true');
          loading.hidden = false;
          errorBox.hidden = true;
          mount.hidden = true;
        };

        const showError = (message: string) => {
          window.clearTimeout(watchdog);
          window.clearTimeout(revealTimer);
          phase = 'error';
          shell.dataset.state = 'error';
          shell.removeAttribute('aria-busy');
          loading.hidden = true;
          mount.hidden = true;
          errorBox.hidden = false;
          if (errorDetail) errorDetail.textContent = message;
        };

        const showComments = () => {
          window.clearTimeout(watchdog);
          window.clearTimeout(revealTimer);
          phase = 'ready';
          shell.dataset.state = 'ready';
          shell.removeAttribute('aria-busy');
          loading.hidden = true;
          errorBox.hidden = true;
          mount.hidden = false;
        };

        const syncCount = () => {
          if (!countEl) return;
          if (phase !== 'ready') {
            countEl.textContent = '';
            countEl.hidden = true;
            return;
          }
          const source = mount.querySelector<HTMLElement>('.tk-comments-count');
          const match = source?.textContent?.match(/\d+/);
          if (match) {
            countEl.textContent = `${match[0]} 条评论`;
            countEl.hidden = false;
          } else {
            countEl.textContent = '';
            countEl.hidden = true;
          }
        };

        const onCommentLoaded = () => {
          showComments();
          syncCount();
        };

        const loadScript = (): Promise<void> => {
          if (scriptPromise) return scriptPromise;

          scriptPromise = new Promise<void>((resolve, reject) => {
            if ((window as TwikooWindow).twikoo) {
              resolve();
              return;
            }

            const existing = document.querySelector<HTMLScriptElement>(
              'script[data-twikoo-client]',
            );
            const script = existing ?? document.createElement('script');

            const handleLoad = () => resolve();
            const handleError = () => {
              scriptPromise = null;
              script.remove();
              reject(new Error('无法加载评论脚本，请检查网络后重试。'));
            };

            script.addEventListener('load', handleLoad, { once: true });
            script.addEventListener('error', handleError, { once: true });

            if (!existing) {
              script.src = scriptUrl;
              script.async = true;
              script.dataset.twikooClient = '';
              document.head.appendChild(script);
            }
          });

          return scriptPromise;
        };

        const init = async () => {
          await loadScript();
          const twikoo = (window as TwikooWindow).twikoo;
          if (!twikoo || typeof twikoo.init !== 'function') {
            throw new Error('评论脚本未正确初始化，请刷新页面重试。');
          }

          await twikoo.init({
            envId,
            el: '#twikoo-comments',
            path: normalizePath(shell.dataset.path ?? window.location.pathname),
            title: shell.dataset.title ?? document.title,
            lang: 'zh-CN',
            onCommentLoaded,
          });

          // 评论为空或加载失败时 onCommentLoaded 不会触发：稍后展示 Twikoo 自己的状态
          revealTimer = window.setTimeout(() => {
            if (phase !== 'ready') showComments();
          }, 6000);
          syncCount();
        };

        const load = async () => {
          showLoading();
          window.clearTimeout(watchdog);
          watchdog = window.setTimeout(() => {
            if (phase !== 'ready') showError('加载超时，请检查网络后重试。');
          }, timeoutMs);

          try {
            await init();
          } catch (error) {
            const message =
              error instanceof Error && error.message
                ? error.message
                : '评论暂时不可用，请稍后重试。';
            showError(message);
          }
        };

        retryButton?.addEventListener('click', () => {
          if (phase === 'loading') return;
          void load();
        });

        const start = () => {
          if (started) return;
          started = true;
          void load();
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                observer.disconnect();
                start();
              }
            },
            { rootMargin: preloadMargin },
          );
          observer.observe(shell);
        } else {
          start();
        }

        if ('MutationObserver' in window) {
          countObserver = new MutationObserver(syncCount);
          countObserver.observe(mount, { childList: true, subtree: true, characterData: true });
        }
      }
    }
  };

  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>
