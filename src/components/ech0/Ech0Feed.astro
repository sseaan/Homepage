---
/**
 * Ech0 只读动态。
 *
 * - 访问 /ech0 时由浏览器直接读取公开 Atom Feed，不经过主站服务端；
 * - 请求不带 Cookie（credentials: 'omit'），有超时与重试；
 * - Feed HTML 经 `src/lib/ech0.ts` 的 DOMPurify 白名单清洗后才会插入页面；
 * - 图片在客户端重排：1 张单图、2–4 张横向轮播、5 张以上 3 列宫格；
 * - 所有媒体可点击查看大图（原生 <dialog>），宫格缩略图不裁切；
 * - 标签从正文中抽出，统一放在正文下方的横向标签行；
 * - 首页/博客/About 不加载本组件，Ech0 故障不影响主站其它页面。
 */
import { siteConfig } from '../../config/site';
import '../../styles/ech0.css';

const { feedUrl, siteUrl, maxItems, requestTimeoutMs } = siteConfig.ech0;
---

<section
  class="ech0-feed"
  data-ech0
  data-feed-url={feedUrl}
  data-site-url={siteUrl}
  data-max-items={String(maxItems)}
  data-timeout={String(requestTimeoutMs)}
  aria-labelledby="ech0-feed-title"
>
  <h2 class="visually-hidden" id="ech0-feed-title">动态列表</h2>

  <div class="ech0-state ech0-state--loading" data-ech0-loading role="status">
    <span class="ech0-spinner" aria-hidden="true"></span>
    <span>正在读取 Ech0…</span>
  </div>

  <div class="ech0-state ech0-state--error" data-ech0-error role="alert" hidden>
    <div class="ech0-state__body">
      <p class="ech0-state__title">动态暂时加载失败</p>
      <p class="ech0-state__detail" data-ech0-error-detail>请检查网络后重试。</p>
      <div class="ech0-state__actions">
        <button class="btn" type="button" data-ech0-retry>重试</button>
        <a class="text-link" href={siteUrl} target="_blank" rel="noopener noreferrer">
          前往 Ech0
        </a>
      </div>
    </div>
  </div>

  <div class="ech0-state ech0-state--empty" data-ech0-empty hidden>
    <p class="ech0-state__title">还没有公开动态</p>
    <p class="ech0-state__detail">
      <a class="text-link" href={siteUrl} target="_blank" rel="noopener noreferrer">
        去 Ech0 看看
      </a>
    </p>
  </div>

  <ul class="ech0-list" data-ech0-list hidden></ul>

  <template data-ech0-template>
    <li class="ech0-item">
      <div class="ech0-item__head">
        <time class="ech0-item__time" data-ech0-time></time>
        <span class="ech0-item__badge">Ech0</span>
      </div>
      <div class="ech0-item__content" data-ech0-content></div>
      <div class="ech0-tags" data-ech0-tags hidden></div>
      <a class="ech0-item__origin" data-ech0-link target="_blank" rel="noopener noreferrer">
        在 Ech0 查看原文 <span aria-hidden="true">↗</span>
      </a>
    </li>
  </template>

  <p class="ech0-feed__foot">
    来自
    <a href={feedUrl} target="_blank" rel="noopener noreferrer">Ech0 Feed</a>
    <span aria-hidden="true">·</span>
    自动更新
  </p>
</section>

<script>
  import { fetchEch0Feed } from '../../lib/ech0';

  const root = document.querySelector<HTMLElement>('[data-ech0]');

  if (root) {
    const feedUrl = root.dataset.feedUrl ?? '';
    const maxItems = Number(root.dataset.maxItems ?? '10') || 10;
    const timeoutMs = Number(root.dataset.timeout ?? '10000') || 10_000;

    const list = root.querySelector<HTMLUListElement>('[data-ech0-list]');
    const template = root.querySelector<HTMLTemplateElement>('[data-ech0-template]');
    const countEl = document.querySelector<HTMLElement>('[data-ech0-count]');
    const loading = root.querySelector<HTMLElement>('[data-ech0-loading]');
    const errorBox = root.querySelector<HTMLElement>('[data-ech0-error]');
    const errorDetail = root.querySelector<HTMLElement>('[data-ech0-error-detail]');
    const empty = root.querySelector<HTMLElement>('[data-ech0-empty]');
    const retryButton = root.querySelector<HTMLButtonElement>('[data-ech0-retry]');

    const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
      dateStyle: 'medium',
      timeStyle: 'short',
    });

    let controller: AbortController | null = null;
    let requestId = 0;

    const setState = (state: 'loading' | 'ready' | 'empty' | 'error') => {
      root.dataset.state = state;
      if (loading) loading.hidden = state !== 'loading';
      if (errorBox) errorBox.hidden = state !== 'error';
      if (empty) empty.hidden = state !== 'empty';
      if (list) list.hidden = state !== 'ready';
      root.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    };

    /** 单图：保持原始比例，最大高度由 CSS 限制 */
    const buildSingle = (image: HTMLImageElement): HTMLElement => {
      const wrapper = document.createElement('div');
      wrapper.className = 'ech0-media ech0-media--single';
      wrapper.append(image);
      return wrapper;
    };

    /** 2–4 张：横向轮播，按钮/方向键/滑动切换 */
    const buildCarousel = (images: HTMLImageElement[]): HTMLElement => {
      const wrapper = document.createElement('div');
      wrapper.className = 'ech0-media ech0-media--carousel';
      wrapper.setAttribute('role', 'group');
      wrapper.setAttribute('aria-roledescription', '轮播');
      wrapper.setAttribute('aria-label', `动态图片，共 ${images.length} 张`);

      const viewport = document.createElement('div');
      viewport.className = 'ech0-carousel';
      viewport.tabIndex = 0;
      viewport.setAttribute('aria-label', '使用左右方向键或滑动查看图片');

      const track = document.createElement('div');
      track.className = 'ech0-carousel__track';

      images.forEach((image, index) => {
        const slide = document.createElement('div');
        slide.className = 'ech0-carousel__slide';
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-label', `第 ${index + 1} 张，共 ${images.length} 张`);
        slide.append(image);
        track.append(slide);
      });

      viewport.append(track);

      const status = document.createElement('span');
      status.className = 'ech0-carousel__status';
      status.setAttribute('aria-hidden', 'true');
      status.textContent = `1 / ${images.length}`;

      const prev = document.createElement('button');
      prev.type = 'button';
      prev.className = 'ech0-carousel__button';
      prev.setAttribute('aria-label', '上一张图片');
      prev.textContent = '←';

      const next = document.createElement('button');
      next.type = 'button';
      next.className = 'ech0-carousel__button';
      next.setAttribute('aria-label', '下一张图片');
      next.textContent = '→';

      const nav = document.createElement('div');
      nav.className = 'ech0-carousel__nav';
      nav.append(prev, next);

      const controls = document.createElement('div');
      controls.className = 'ech0-carousel__controls';
      controls.append(status, nav);

      wrapper.append(viewport, controls);

      const currentIndex = () => {
        const width = viewport.clientWidth || 1;
        return Math.min(images.length - 1, Math.max(0, Math.round(viewport.scrollLeft / width)));
      };

      const update = () => {
        const index = currentIndex();
        status.textContent = `${index + 1} / ${images.length}`;
        prev.disabled = index === 0;
        next.disabled = index === images.length - 1;
      };

      const goTo = (index: number) => {
        const target = Math.min(images.length - 1, Math.max(0, index));
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        viewport.scrollTo({
          left: target * (viewport.clientWidth || 1),
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      };

      let frame = 0;
      viewport.addEventListener(
        'scroll',
        () => {
          if (frame) return;
          frame = window.requestAnimationFrame(() => {
            frame = 0;
            update();
          });
        },
        { passive: true },
      );

      prev.addEventListener('click', () => goTo(currentIndex() - 1));
      next.addEventListener('click', () => goTo(currentIndex() + 1));

      viewport.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goTo(currentIndex() - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          goTo(currentIndex() + 1);
        }
      });

      window.addEventListener('resize', update);
      update();

      return wrapper;
    };

    /** 5 张以上：3 列宫格；超过 9 张时第 9 格显示剩余数量 */
    const buildGrid = (images: HTMLImageElement[], itemUrl: string): HTMLElement => {
      const wrapper = document.createElement('div');
      wrapper.className = 'ech0-media ech0-media--grid';
      wrapper.setAttribute('role', 'group');
      wrapper.setAttribute(
        'aria-label',
        `动态图片，共 ${images.length} 张${images.length > 9 ? '，显示前 9 张' : ''}`,
      );

      const shown = images.slice(0, 9);

      shown.forEach((image, index) => {
        const cell = document.createElement('div');
        cell.className = 'ech0-grid__cell';

        if (images.length > 9 && index === shown.length - 1) {
          const link = document.createElement('a');
          link.className = 'ech0-grid__link';
          link.href = itemUrl;
          link.target = '_blank';
          link.rel = 'noopener noreferrer nofollow ugc';
          link.setAttribute(
            'aria-label',
            `还有 ${images.length - shown.length} 张图片，在 Ech0 查看`,
          );
          link.append(image);

          const more = document.createElement('span');
          more.className = 'ech0-grid__more';
          more.setAttribute('aria-hidden', 'true');
          more.textContent = `+${images.length - shown.length}`;
          link.append(more);
          cell.append(link);
        } else {
          cell.append(image);
        }

        wrapper.append(cell);
      });

      return wrapper;
    };

    /** 清掉图片/标签被移走后留下的空段落与多余换行 */
    const cleanupContent = (content: HTMLElement) => {
      content.querySelectorAll('p').forEach((paragraph) => {
        if (!paragraph.textContent?.trim() && !paragraph.querySelector('img, .ech0-media')) {
          paragraph.remove();
        }
      });

      content.querySelectorAll('br').forEach((br) => {
        const previous = br.previousSibling;
        const next = br.nextSibling;
        const previousEmpty =
          !previous || (previous.nodeType === Node.TEXT_NODE && !previous.textContent?.trim());
        const nextEmpty = !next || (next.nodeType === Node.TEXT_NODE && !next.textContent?.trim());
        if (previousEmpty && nextEmpty) br.remove();
      });

      // 去掉首尾的空文本与换行（标签移走后常见的 <br><br>）
      const isBlankNode = (node: Node) =>
        (node.nodeType === Node.TEXT_NODE && !node.textContent?.trim()) ||
        (node.nodeType === Node.ELEMENT_NODE && (node as Element).tagName === 'BR');

      while (content.firstChild && isBlankNode(content.firstChild)) content.firstChild.remove();
      while (content.lastChild && isBlankNode(content.lastChild)) content.lastChild.remove();
    };

    /** 把正文里的图片重排成单图 / 轮播 / 宫格 */
    const arrangeMedia = (content: HTMLElement, itemUrl: string) => {
      const images = Array.from(content.querySelectorAll<HTMLImageElement>('img'));
      if (images.length === 0) return;

      images.forEach((image) => image.remove());

      const media =
        images.length === 1
          ? buildSingle(images[0])
          : images.length <= 4
            ? buildCarousel(images)
            : buildGrid(images, itemUrl);

      content.prepend(media);
    };

    /** 标签统一抽到正文下方，横向排列 */
    const moveTags = (content: HTMLElement, tagsBox: HTMLElement | null) => {
      if (!tagsBox) return;
      const tags = Array.from(content.querySelectorAll<HTMLElement>('.ech0-tag'));
      if (tags.length === 0) return;

      tags.forEach((tag) => tagsBox.append(tag));
      tagsBox.hidden = false;
    };

    const renderItems = (items: Awaited<ReturnType<typeof fetchEch0Feed>>['items']) => {
      if (!list || !template) return;

      const fragment = document.createDocumentFragment();

      for (const item of items) {
        const node = template.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
        if (!node) continue;

        const time = node.querySelector<HTMLTimeElement>('[data-ech0-time]');
        if (time) {
          time.dateTime = item.publishedAt.toISOString();
          time.textContent = dateFormatter.format(item.publishedAt);
          time.title = item.title || item.publishedAt.toISOString();
        }

        const content = node.querySelector<HTMLElement>('[data-ech0-content]');
        const tagsBox = node.querySelector<HTMLElement>('[data-ech0-tags]');

        if (content) {
          // 已在 lib/ech0.ts 经 DOMPurify 白名单清洗
          content.innerHTML = item.html;
          content.querySelectorAll('img').forEach((image) => {
            image.addEventListener('error', () => image.remove(), { once: true });
          });

          moveTags(content, tagsBox);
          arrangeMedia(content, item.url);
          cleanupContent(content);
          content.dataset.lightboxGroup = '';

          const hasMedia = Boolean(content.querySelector('.ech0-media'));
          const hasText = Boolean(content.textContent?.trim());
          const hasTags = Boolean(tagsBox && !tagsBox.hidden);

          if (!hasMedia && !hasText && !hasTags) {
            const placeholder = document.createElement('p');
            placeholder.className = 'ech0-item__placeholder';
            placeholder.textContent = '这条动态没有正文。';
            content.append(placeholder);
          }
        }

        const link = node.querySelector<HTMLAnchorElement>('[data-ech0-link]');
        if (link) link.href = item.url;

        fragment.append(node);
      }

      list.replaceChildren(fragment);
    };

    const load = async () => {
      if (!feedUrl) return;

      const id = ++requestId;
      controller?.abort();
      controller = new AbortController();

      if (countEl) countEl.textContent = '读取中…';
      setState('loading');

      try {
        const feed = await fetchEch0Feed({
          feedUrl,
          maxItems,
          timeoutMs,
          signal: controller.signal,
        });

        if (id !== requestId) return;

        if (feed.items.length === 0) {
          if (countEl) countEl.textContent = '暂无动态';
          setState('empty');
          return;
        }

        renderItems(feed.items);
        if (countEl) {
          countEl.textContent =
            feed.total > feed.items.length
              ? `最近 ${feed.items.length} 条`
              : `${feed.items.length} 条动态`;
        }
        setState('ready');
      } catch (error) {
        if (id !== requestId) return;
        if (errorDetail) {
          errorDetail.textContent =
            error instanceof Error && error.message ? error.message : '请检查网络后重试。';
        }
        if (countEl) countEl.textContent = '加载失败';
        setState('error');
      }
    };

    retryButton?.addEventListener('click', () => void load());

    void load();
  }
</script>
