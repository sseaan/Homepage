---
import Icon from '../icons/Icon.astro';
import '../../styles/music.css';

interface Props {
  /** 全局网易云歌单链接或纯数字歌单 ID；null 时只保留文章音乐能力 */
  globalSource?: string | null;
  /** 纯数字全局源的默认类型；默认按歌单处理 */
  globalSourceType?: 'song' | 'playlist';
  /** 当前页面是否带文章音乐（首屏渲染时决定要不要输出播放器） */
  pageMusic?: string | null;
  /** 全局入口按钮文字 */
  label?: string;
}

const {
  globalSource = null,
  globalSourceType = 'playlist',
  pageMusic = null,
  label = '听歌',
} = Astro.props;
const apiBase = (import.meta.env.PUBLIC_NETEASE_API_BASE ?? '').replace(/\/+$/, '');
const enabled = Boolean(apiBase && (globalSource?.trim() || pageMusic?.trim()));
---

{
  enabled && (
    <div
      class="music-player"
      id="site-music-player"
      transition:persist="site-music-player"
      data-music-player
      data-api-base={apiBase}
      data-mode="global"
      data-global-source={globalSource ?? ''}
      data-global-source-type={globalSourceType}
      data-state="idle"
      data-open="false"
      data-playing="false"
      data-dismissed="false"
      hidden
    >
      <button
        class="music-launcher"
        type="button"
        data-music-launcher
        aria-expanded="false"
        aria-controls="music-panel"
        aria-label="打开音乐播放器"
      >
        <Icon name="music" size={18} />
        <span>{label}</span>
        <span class="music-launcher__bars" data-music-bars aria-hidden="true" hidden>
          <i />
          <i />
          <i />
        </span>
      </button>

      <section
        class="music-panel"
        id="music-panel"
        data-music-panel
        tabindex="-1"
        aria-label="音乐播放器"
        hidden
      >
        <header class="music-panel__header">
          <div class="music-panel__heading">
            <p class="music-panel__eyebrow" data-music-collection-label>
              歌单
            </p>
            <p class="music-panel__collection" data-music-collection-name>
              加载中…
            </p>
          </div>
          <button
            class="music-panel__close"
            type="button"
            data-music-collapse
            aria-label="收起播放器"
            title="收起"
          >
            ×
          </button>
        </header>

        <div class="music-panel__now">
          <div class="music-panel__cover">
            <span class="music-panel__cover-placeholder" data-music-panel-placeholder>
              <Icon name="music" size={20} />
            </span>
            <img data-music-panel-cover alt="" width="112" height="112" loading="lazy" hidden />
          </div>
          <div class="music-panel__track-info">
            <p class="music-panel__song" data-music-song>
              正在加载歌单…
            </p>
            <p class="music-panel__artist" data-music-artist />
          </div>
        </div>

        <div class="music-panel__controls">
          <div class="music-panel__transport">
            <button
              type="button"
              data-music-shuffle
              aria-label="随机播放"
              aria-pressed="false"
              title="随机播放"
            >
              <Icon name="shuffle" size={15} />
            </button>
            <button type="button" data-music-prev aria-label="上一首" title="上一首">
              <Icon name="skip-back" size={16} />
            </button>
            <button
              class="music-panel__play"
              type="button"
              data-music-play
              aria-label="播放"
              aria-pressed="false"
              title="播放 / 暂停"
            >
              <span data-music-play-icon>
                <Icon name="play" size={16} />
              </span>
              <span data-music-pause-icon hidden>
                <Icon name="pause" size={16} />
              </span>
            </button>
            <button type="button" data-music-next aria-label="下一首" title="下一首">
              <Icon name="skip-forward" size={16} />
            </button>
            <button
              type="button"
              data-music-mute
              aria-label="静音"
              aria-pressed="false"
              title="静音"
            >
              <span data-music-volume-on>
                <Icon name="volume" size={15} />
              </span>
              <span data-music-volume-off hidden>
                <Icon name="volume-x" size={15} />
              </span>
            </button>
            <input
              class="music-panel__volume"
              type="range"
              min="0"
              max="1"
              step="0.01"
              value="0.8"
              data-music-volume
              aria-label="音量"
            />
          </div>
          <div class="music-panel__timeline">
            <input
              type="range"
              min="0"
              max="100"
              step="0.1"
              value="0"
              data-music-progress
              aria-label="播放进度"
              disabled
            />
            <span data-music-time>0:00 / 0:00</span>
          </div>
        </div>

        <div class="music-panel__tabs" role="tablist" aria-label="播放器视图">
          <button
            class="music-panel__tab"
            id="music-tab-list"
            type="button"
            role="tab"
            data-music-tab="list"
            aria-selected="true"
            aria-controls="music-list-panel"
          >
            曲目
          </button>
          <button
            class="music-panel__tab"
            id="music-tab-lyrics"
            type="button"
            role="tab"
            data-music-tab="lyrics"
            aria-selected="false"
            aria-controls="music-lyrics-panel"
            tabindex="-1"
          >
            歌词
          </button>
        </div>

        <p class="music-panel__status" data-music-status role="status">
          正在加载歌单…
        </p>
        <p class="music-panel__error" data-music-panel-error role="status" hidden />

        <div
          id="music-list-panel"
          data-music-list-panel
          role="tabpanel"
          aria-labelledby="music-tab-list"
        >
          <ol class="music-panel__list" data-music-list hidden />
        </div>

        <div
          id="music-lyrics-panel"
          data-music-lyrics-panel
          role="tabpanel"
          aria-labelledby="music-tab-lyrics"
          hidden
        >
          <div class="music-panel__lyrics" data-music-lyrics>
            <p class="music-panel__lyric-empty">播放歌曲后显示歌词。</p>
          </div>
        </div>
      </section>

      <div class="music-cover-player" data-music-article>
        <button
          class="music-cover"
          type="button"
          data-music-toggle
          aria-label="播放文章音乐"
          aria-pressed="false"
        >
          <span class="music-cover__placeholder" data-music-placeholder>
            <Icon name="music" size={24} />
          </span>
          <img
            data-music-cover
            alt=""
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
            hidden
          />
          <span class="music-cover__icon" data-music-toggle-icon aria-hidden="true">
            {' '}
            ▶{' '}
          </span>
          <span class="music-cover__spinner" data-music-spinner aria-hidden="true" />
        </button>
        <button
          class="music-cover__close"
          type="button"
          data-music-article-close
          aria-label="关闭音乐播放器"
          title="关闭"
        >
          ×
        </button>
      </div>

      <p class="music-error" data-music-article-error role="status" hidden />
      <audio data-music-audio preload="none" />
    </div>
  )
}

<script>
  import '../../lib/netease-player';
</script>
